<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bar_bg"
        android:padding="8dp">

        <!-- 第一行：导航按钮 + 地址栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    style="@style/NavButton"
                    android:text="←" />

                <Button
                    android:id="@+id/btnForward"
                    style="@style/NavButton"
                    android:text="→" />

                <Button
                    android:id="@+id/btnReload"
                    style="@style/NavButton"
                    android:text="↻" />

                <Button
                    android:id="@+id/btnHome"
                    style="@style/NavButton"
                    android:text="⌂" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/addr_bg"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/lockIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="11sp"
                    android:alpha="0.7"
                    android:layout_gravity="start|center_vertical" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="46dp"
                    android:background="@null"
                    android:hint="@string/hint_url"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:singleLine="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

                <Button
                    android:id="@+id/btnGo"
                    android:layout_width="40dp"
                    android:layout_height="26dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/go_btn_bg"
                    android:text="@string/go"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第二行：本网站 + 开关 + 计数 + 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_label"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/homeDomain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_none"
                    android:textColor="@color/chip_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/toggleRedirects"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:text="@string/toggle_redirects"
                    android:textSize="12sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/toggleAds"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:text="@string/toggle_ads"
                    android:textSize="12sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/countsBox"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/count_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/redirectCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="跳转 0"
                    android:textColor="@color/danger"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="@color/danger"
                    android:textSize="12sp"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/adCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="广告 0"
                    android:textColor="@color/danger"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="@string/status_ready"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- 网页内容区 -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
